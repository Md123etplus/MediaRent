server {
    listen 8080;  # ← Must be exactly this (no IP specified)
    server_name _;
    root /var/www/html/public;
    index index.php index.html index.htm;

    charset utf-8;
    client_max_body_size 2048M;
    access_log /dev/stdout fly;

    # ▼▼▼ CRITICAL FIXES START HERE ▼▼▼
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        
        # Emergency debug (uncomment if still failing)
        # error_log /var/log/nginx/php_errors.log debug;
    }
    # ▲▲▲ CRITICAL FIXES END HERE ▲▲▲

    # Static files handling (keep existing)
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        log_not_found off;
        access_log off;
    }

    location ~* \.(?:css|js|jpg|png|gif|ico)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    location ~* \.(?:svgz?|ttf|ttc|otf|eot|woff2?)$ {
        add_header Access-Control-Allow-Origin "*";
        expires 7d;
        access_log off;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
    

    # Security headers (keep existing)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}